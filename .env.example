# Firebase Web configuration. These values identify a Firebase project and are
# intentionally loaded from the host application's environment, never embedded
# in committed source. Do not put a service-account key in this file.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Callable Functions region. Set this to the region selected during deployment.
FIREBASE_FUNCTIONS_REGION=asia-south1

# Set to true only for deliberate local development with the Emulator Suite.
FIREBASE_USE_EMULATORS=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
